# Files NOT to upload to Cloud Build. When this file exists it completely
# replaces .gitignore for upload-exclusion, so list everything explicitly.

# Git metadata — never needed in the image
.git
.gitignore
.gitattributes

# Local Python
.venv
__pycache__
*.pyc
.pytest_cache

# Local dev artifacts
.DS_Store
.env
.claude

# Frontend — node_modules and dist are regenerated inside the Dockerfile's
# stage 1; uploading them wastes 380+ MB and stalls queueing.
frontend/node_modules
frontend/dist
frontend/.vite
frontend/.cache

# Data that's either regenerated by scripts or not needed in the image
data/wikivoyage_cache

# IDE / misc
.vscode
.idea
*.swp
